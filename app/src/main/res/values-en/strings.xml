    <string name="guide_title">Guide</string>
    <string name="g_quick">Quick start</string>
    <string name="g_quick_sub">How to start Jeremy</string>
    <string name="g_quick_body">Tap \"Start drive\" on the home screen. The camera starts recording immediately in the background. You can leave the app and open Waze, Spotify or anything else — Jeremy keeps protecting you.</string>
    <string name="g_drive">Using while driving</string>
    <string name="g_drive_sub">Background operation</string>
    <string name="g_drive_body">Jeremy records continuously and keeps the last seconds in a rolling buffer. A video is created only when you save an event — including the seconds before you tapped.</string>
    <string name="g_event">Saving an event</string>
    <string name="g_event_sub">Ways to trigger an event</string>
    <string name="g_event_body">An event starts from the camera screen, the floating button, the notification, a voice command or impact/motion detection. It keeps recording until you stop it, then one MP4 file with Jeremy branding is created.</string>
    <string name="g_float">Floating button</string>
    <string name="g_float_sub">How to use it</string>
    <string name="g_float_body">When you leave Jeremy during a drive, a round button appears over other apps. Tap — start/save an event. Long-press — fully turn off the camera. Drag it anywhere.</string>
    <string name="g_voice">Voice commands</string>
    <string name="g_voice_sub">Hands-free control</string>
    <string name="g_voice_body">Say the start phrase (default: \"start event\") or stop phrase (\"stop event\"). You can change them in settings. Jeremy confirms out loud.</string>
    <string name="g_share">Viewing &amp; sharing</string>
    <string name="g_share_sub">Events screen</string>
    <string name="g_share_body">In the events screen pick an event to watch, share (one continuous file), rename, lock or delete. A locked event is never auto-deleted.</string>
    <string name="g_settings">Important settings</string>
    <string name="g_settings_sub">Permissions &amp; battery</string>
    <string name="g_settings_body">For the floating button, allow \"Display over other apps\". It\'s recommended to disable battery optimization for Jeremy so the system doesn\'t stop it.</string>
