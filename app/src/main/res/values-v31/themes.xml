<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: keep the system splash plain dark-green so it flows straight into the driving animation. -->
    <style name="Theme.Jeremy" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/jeremy_bg</item>
        <item name="android:statusBarColor">@color/jeremy_bg</item>
        <item name="android:navigationBarColor">@color/jeremy_bg</item>
        <item name="colorPrimary">@color/jeremy_green</item>
        <item name="colorAccent">@color/jeremy_mint</item>
        <item name="android:windowSplashScreenBackground">@color/jeremy_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
