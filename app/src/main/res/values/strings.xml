    <string name="g_quick">התחלה מהירה</string>
    <string name="g_quick_sub">איך להפעיל את Jeremy</string>
    <string name="g_quick_body">לחץ על \"הפעל נסיעה\" במסך הראשי. המצלמה מתחילה לצלם מיד ברקע. אפשר לצאת מהאפליקציה ולפתוח Waze, Spotify או כל אפליקציה אחרת — Jeremy ממשיכה להגן.</string>
    <string name="g_drive">שימוש בזמן נהיגה</string>
    <string name="g_drive_sub">עבודה ברקע</string>
    <string name="g_drive_body">Jeremy מצלמת ברציפות ושומרת זמנית את השניות האחרונות (Rolling Buffer). רק כששומרים אירוע נוצר סרטון — הכולל גם את השניות שלפני השמירה.</string>
    <string name="g_event">שמירת אירוע</string>
    <string name="g_event_sub">דרכים להפעלת אירוע</string>
    <string name="g_event_body">אירוע מתחיל מכפתור במסך המצלמה, מהכפתור הצף, מההתראה, בפקודה קולית או בזיהוי מכה/תנועה. האירוע ממשיך להקליט עד שעוצרים אותו, ובסיום נוצר קובץ MP4 אחד עם מיתוג Jeremy.</string>
    <string name="g_float">הכפתור הצף</string>
    <string name="g_float_sub">איך משתמשים</string>
    <string name="g_float_body">כשיוצאים מ־Jeremy בזמן נסיעה מופיע כפתור עגול מעל אפליקציות אחרות. לחיצה — התחלה/שמירת אירוע. לחיצה ארוכה — כיבוי מלא של המצלמה. אפשר לגרור אותו לכל מקום.</string>
    <string name="g_voice">פקודות קוליות</string>
    <string name="g_voice_sub">הפעלה ללא ידיים</string>
    <string name="g_voice_body">אמור את פקודת ההתחלה (ברירת מחדל: \"אירוע התחל\") או הסיום (\"סיים אירוע\"). את הפקודות אפשר לשנות בהגדרות. Jeremy תאשר בקול.</string>
    <string name="g_share">צפייה ושיתוף סרטונים</string>
    <string name="g_share_sub">מסך האירועים</string>
    <string name="g_share_body">במסך האירועים בחר אירוע כדי לצפות, לשתף (קובץ אחד רציף), לשנות שם, לנעול או למחוק. אירוע נעול לעולם לא יימחק אוטומטית.</string>
    <string name="g_settings">הגדרות חשובות</string>
    <string name="g_settings_sub">הרשאות וחיסכון בסוללה</string>
    <string name="g_settings_body">כדי שהכפתור הצף יעבוד יש לאשר \"הצגה מעל אפליקציות אחרות\". מומלץ לבטל אופטימיזציית סוללה עבור Jeremy כדי שהמערכת לא תעצור אותה.</string>
