    <string name="guide_1_t">1. משמרת = כוננות</string>
    <string name="guide_1">כשהמשמרת פעילה המצלמה עובדת ברקע (גם עם מסך כבוי) ושומרת רק את השניות האחרונות. אף סרטון לא נשמר עד שמתחילים תיעוד.</string>
    <string name="guide_2_t">2. תיעוד</string>
    <string name="guide_2">לחיצה אחת על הקלט, כפתור הגברת השמע, הכפתור הצף, ההתראה, ניעור או פקודה קולית. הסרטון כולל גם את השניות שלפני. לעצירה מחזיקים את הכפתור – כך מכה מקרית לא עוצרת תיעוד.</string>
    <string name="guide_3_t">3. מצב כיס</string>
    <string name="guide_3">מסך שחור בבהירות מינימלית, נגיעות לא עושות כלום. כפתור הגברת השמע עדיין מתחיל ועוצר. הקשה כפולה יוצאת.</string>
    <string name="guide_4_t">4. רטט במקום מבט</string>
    <string name="guide_4">רטט ארוך = התחיל לתעד. שני קצרים = נעצר. שלושה קצרים = נשמר ונחתם.</string>
    <string name="guide_5_t">5. זיהוי נפילה</string>
    <string name="guide_5">נפילה ואחריה שכיבה ללא תזוזה מתחילות תיעוד לבד. אם הגדרת איש קשר, מופיעה ספירה לאחור עם צפצוף, ובסופה חיוג.</string>
    <string name="guide_6_t">6. ראיה חתומה</string>
    <string name="guide_6">כל סרטון מקבל טביעת אצבע SHA-256 ברגע השמירה, ונשמר נעול. במסך התיעוד אפשר לבדוק שהקובץ לא שונה. בשיתוף נשלחת הטביעה המלאה.</string>
    <string name="ob1_title">מצלמת גוף שזוכרת גם את מה שהיה לפני</string>
    <string name="ob1_body">לבש את הטלפון על החזה. Shomer מקליט ברקע ושומר רק כשאתה מחליט – יחד עם השניות שלפני.</string>
    <string name="ob_p1">בכוננות לאורך כל המשמרת, גם עם מסך כבוי</string>
    <string name="ob_p2">כל תיעוד נחתם ב־SHA-256 ונשמר נעול כראיה</string>
    <string name="ob2_title">נבנה לשטח</string>
    <string name="ob_p3">כפתור הגברת השמע או ניעור – בלי להסתכל על המסך</string>
    <string name="ob_p4">מצב כיס: מסך שחור שלא מגיב לנגיעות</string>
    <string name="ob_p5">רטט שונה להתחלה, לעצירה ולשמירה</string>
    <string name="ob_p6">זיהוי נפילה עם חיוג חירום</string>
    <string name="ob3_title">מי מצלם?</string>
    <string name="ob3_body">השם או מספר התג ייצרבו בפינת כל סרטון, יחד עם התאריך, השעה והמיקום. אפשר לשנות בהגדרות.</string>
